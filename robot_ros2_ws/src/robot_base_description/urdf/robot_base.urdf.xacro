  </link>
  <joint name="link_laser_joint" type="fixed">
    <origin xyz="0.39559392 0.067257614 -0.65665369" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="link_laser" />
  </joint>
  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="-0.07499999 0.102 -0.061999973" rpy="-1.5707963 0 0" />
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <axis xyz="0 0 -1" />
    <limit effort="10" velocity="5" />
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="-0.07499999 -0.118 -0.061999973" rpy="1.5707963 0 0" />
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="5" />
  </joint>

  <!-- ==========================================================================
       运动学/显示补充
       ========================================================================== -->
  <link name="base_footprint"/>
  <!-- 2026-11-05 修正：车体/base_link 保持 CAD +X 朝向，不再整车旋转 180°。
       之前“模型反了”的根因是 laser_frame 的 yaw 方向错误（见下方
       laser_frame_joint，已改为 +90°），不是车体本身。 -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0.075 0 0.103" rpy="0 0 0"/>
  </joint>

  <!-- Nav2/Gazebo 用的保守圆形包络：矩形包络 0.291 x 0.236 的外接圆。
       车体保持 CAD 朝向后，包络圆心仍在 +0.1005。 -->
  <link name="navigation_footprint">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.19" length="0.01"/></geometry>
      <material name="navigation_boundary"><color rgba="0.0 0.75 0.85 0.30"/></material>
    </visual>
    <xacro:unless value="$(arg use_gazebo)">
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder radius="0.19" length="0.01"/></geometry>
      </collision>
    </xacro:unless>
  </link>
  <joint name="navigation_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="navigation_footprint"/>
    <origin xyz="0.1005 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- 雷达扫描坐标系：放在雷达圆柱【顶面圆心】（CAD 系 x=0.1475, z=-0.0168）。
       link_laser 的网格保留在原位；laser_frame 是驱动发布数据用的坐标系。
       2026-11-05 速度/雷达交叉验证：raw laser_frame -Y（扫描角 -90°）
       才是物理车头，因此这里 yaw = +90°（不是 -90°）：
         raw -90° + 90° = base_link 0°（车头）
         raw +90° + 90° = base_link 180°（车尾/自回波）
       正前方箱体实测在 raw -105°，映射到 base_link 约 -15°。 -->
  <link name="laser_frame"/>
  <joint name="laser_frame_joint" type="fixed">
    <parent link="link_laser"/><child link="laser_frame"/>
    <origin xyz="-0.24809392 -0.067257614 0.63985369"
            rpy="0 0 1.5707963267948966"/>
  </joint>

  <!-- ros2_control：真机走 USB CDC；仿真走 gz_ros2_control。 -->
  <ros2_control name="RobotBaseSystem" type="system">
    <hardware>
      <xacro:if value="$(arg use_gazebo)">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:unless value="$(arg use_gazebo)">
        <plugin>robot_base_driver/RobotBaseSystem</plugin>
        <param name="serial_port">/dev/stm32</param>
        <param name="baud_rate">115200</param>
      </xacro:unless>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <xacro:if value="$(arg use_gazebo)">
    <xacro:include filename="$(find robot_base_description)/urdf/robot_base.gazebo.xacro"/>
    <xacro:gazebo_sim/>
  </xacro:if>
</robot>