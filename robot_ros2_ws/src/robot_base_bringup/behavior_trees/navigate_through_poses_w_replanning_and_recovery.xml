<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode name="NavigateRecovery"
                  number_of_retries="6">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1">
          <RecoveryNode name="ComputePathThroughRecovery"
                        number_of_retries="3">
            <ReactiveSequence name="ComputePathSequence">
              <RemovePassedGoals input_goals="{goals}"
                                 output_goals="{goals}"
                                 radius="0.3"
                                 robot_base_frame="base_footprint"/>
              <ComputePathThroughPoses name="ComputePathThroughAction" goals="{goals}"
                                       path="{path}"
                                       planner_id="GridBased"/>
            </ReactiveSequence>
            <Sequence name="ClearGlobalAfterCompute">
              <ClearEntireCostmap name="ClearGlobalCostmap-Context"
                                  service_name="global_costmap/clear_entirely_global_costmap"/>
              <Wait name="WaitAfterGlobalClear" wait_duration="2.0"/>
            </Sequence>
          </RecoveryNode>
        </RateController>
        <RecoveryNode name="FollowPathRecovery"
                      number_of_retries="6">
          <FollowPath name="FollowPathAction" path="{path}"
                      controller_id="FollowPath"/>
          <Sequence name="ClearLocalAfterFollow">
            <ClearEntireCostmap name="ClearLocalCostmap-Context"
                                service_name="local_costmap/clear_entirely_local_costmap"/>
            <Wait name="WaitAfterLocalClear" wait_duration="1.0"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree"
                                service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree"
                                service_name="global_costmap/clear_entirely_global_costmap"/>
            <Wait name="WaitAfterFallbackClear" wait_duration="2.0"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <BackUp backup_dist="0.20" backup_speed="0.15"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
