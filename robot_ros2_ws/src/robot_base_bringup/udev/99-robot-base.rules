# 机器人底座 USB 串口命名规则：给设备固定别名。
#
# 安装（本文件由 CMake 装到 share/ 下，从那里拷到 /etc）：
#   sudo install -m 0644 install/robot_base_bringup/share/robot_base_bringup/udev/99-robot-base.rules \
#        /etc/udev/rules.d/99-robot-base.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger --subsystem-match=tty
#   ls -l /dev/ydlidar /dev/dap-vcp /dev/stm32
#
# 改完务必过一遍语法：        udevadm verify /etc/udev/rules.d/99-robot-base.rules
# 属性值必须来自【实际设备】，不要照抄本文件的旧值：
#   udevadm info -a -n /dev/ttyACM0 | grep -E "looking at|ATTRS\{(devpath|idVendor|idProduct|serial)\}"
#
# ⚠️ 旧部署里可能还存在一个 /etc/udev/rules.d/99-stm32.rules（同一台机器上的重复副本，
#    不在本仓库里）。装本文件后应删掉它，避免两条规则各说各话：
#   sudo rm -f /etc/udev/rules.d/99-stm32.rules

# ---------------------------------------------------------------------------
# 本机实测拓扑（2026-11-05，树莓派 Debian 12 / 内核 6.12）
#
#   STM32H743 USB CDC    总线 1 -> 物理口 1-2
#                        0483:5740  SN 337434543133 -> ttyACM0
#   Horco CMSIS-DAP v2   总线 1 -> hub 1-1 -> 物理口 1-1.1
#                        faed:4873  SN d9381b44    -> ttyACM1（调试器 VCP）
#   YDLidar T-mini Plus  总线 3 -> 物理口 3-2 (devpath "2")
#                        10c4:ea60  SN 0001        -> ttyUSB0
#
# ⚠️ ttyACM 的编号（ttyACM0 / ttyACM1）由枚举顺序决定，会随插拔、重启变化。
#    不要写死编号：STM32 按 0483:5740 匹配，调试器按物理口 1-1.1 匹配，
#    最终都以 /dev/stm32、/dev/dap-vcp 这两个稳定软链接为准。
#
# 当前 H743 固件（RobStride05_H743）已实现 USB Device + CDC（App/app_usb.c），
# 烧录后 STM32 会枚举出 0483:5740 的原生虚拟串口，/dev/stm32 由下面第一条
# 规则生成；DAPLink 的 VCP 单独叫 /dev/dap-vcp，不会被误当成底盘 MCU 串口。
#
# ⚠️ 换到别的 USB 口后 KERNELS 会变，需要重新测量并修改。

# ---------------------------------------------------------------------------
# STM32H743 原生 USB CDC（底盘电机控制器）-> /dev/stm32
# 按 VID:PID 匹配，不依赖物理口，换 USB 口后仍然有效。
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", GROUP="dialout", MODE="0660", SYMLINK+="stm32"

# ---------------------------------------------------------------------------
# Horco CMSIS-DAP v2 调试器虚拟串口 -> /dev/dap-vcp
SUBSYSTEM=="tty", KERNEL=="ttyACM*", KERNELS=="1-1.1", ATTRS{idVendor}=="faed", ATTRS{idProduct}=="4873", ATTRS{serial}=="d9381b44", GROUP="dialout", MODE="0660", SYMLINK+="dap-vcp"

# ---------------------------------------------------------------------------
# YDLIDAR T-mini Plus (CP2102) -> /dev/ydlidar
# CP2102 的序列号是通用值 "0001"（同型号设备全都一样），只能按物理口区分。
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", KERNELS=="3-2", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", GROUP="dialout", MODE="0660", SYMLINK+="ydlidar"

# 兜底规则：按 devpath（本机为 "2"）匹配。KERNELS 那条失效时仍能命中，
# 两条同时命中只是重复创建同一个软链接，无害。
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{devpath}=="2", GROUP="dialout", MODE="0660", SYMLINK+="ydlidar"
