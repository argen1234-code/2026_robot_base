.pure-page { padding-bottom: 40rpx; }
.header-card { color: #fff; background: linear-gradient(135deg, #14532d, #16a34a); }
.header-card .muted { margin-top: 12rpx; color: #bbf7d0; }
.section-title { margin-bottom: 16rpx; font-weight: 700; }
.mode-entry-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; }
.mode-entry { width: 100%; height: 76rpx; line-height: 76rpx; margin: 0; padding: 0 6rpx; border-radius: 14rpx; color: #334155; background: #e2e8f0; font-size: 23rpx; }
.mode-entry::after { border: 0; }.mode-entry.active { color: #fff; background: #1e3a8a; }.mode-entry.switching { color: #fff; background: #2563eb; }.mode-entry-pressed { transform: translateY(5rpx) scale(.95); background: #0f245f !important; color: #fff !important; }
.map-card { padding: 14rpx; }.point-limit { color: #15803d; font-weight: 700; }.gps-map { width: 100%; height: 620rpx; border-radius: 16rpx; overflow: hidden; }.map-empty { height: 500rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 12rpx; color: #64748b; }.map-tip { padding: 14rpx 4rpx 2rpx; text-align: center; color: #64748b; font-size: 22rpx; }
.toolbar { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; padding: 18rpx; }.tool-btn { width: 100%; height: 76rpx; line-height: 76rpx; margin: 0; padding: 0 5rpx; color: #fff; background: #166534; box-shadow: 0 7rpx 0 #14532d; font-size: 22rpx; }.tool-btn::after { border: 0; }.tool-pressed { transform: translateY(6rpx) scale(.96); background: #14532d !important; box-shadow: 0 2rpx 0 #052e16; }
.point-row,.route-row { display: flex; align-items: center; gap: 10rpx; padding: 14rpx 0; border-bottom: 1rpx solid #e2e8f0; }.point-number { width: 44rpx; height: 44rpx; line-height: 44rpx; flex: none; border-radius: 50%; text-align: center; color: #fff; background: #f59e0b; }.point-info,.route-info { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 5rpx; font-size: 22rpx; }.mini-btn { min-width: 48rpx; height: 48rpx; line-height: 48rpx; padding: 0; margin: 0; background: #e2e8f0; }.mini-btn.delete,.route-btn.delete { color: #b91c1c; }.save-btn { margin-top: 20rpx; color: #166534; background: #dcfce7; }.send-btn { margin-top: 16rpx; }.clear-device-btn { margin-top: 16rpx; color: #b91c1c; background: #fee2e2; }.route-name { font-weight: 700; }.route-btn { min-width: 92rpx; height: 58rpx; line-height: 58rpx; padding: 0 12rpx; margin: 0; font-size: 22rpx; background: #e2e8f0; }
.button-pressed { transform: translateY(4rpx) scale(.97); opacity: .85; }.primary-pressed { transform: translateY(4rpx) scale(.97); background: #1d4ed8 !important; }
.speed-row { margin: 8rpx 0 18rpx; color: #334155; font-size: 24rpx; }
