.section-title { font-weight: 700; margin-bottom: 20rpx; }.mode-row { display: flex; gap: 12rpx; }.mode-btn { flex: 1; padding: 0; font-size: 24rpx; background: #e2e8f0; transition: transform .08s, background-color .08s, box-shadow .08s; box-shadow: 0 6rpx 12rpx rgba(15,23,42,.08); }.mode-btn.selected { background: #1e3a8a; color: #fff; box-shadow: 0 8rpx 18rpx rgba(30,58,138,.3); }.mode-btn.pending { background: #1d4ed8; animation: mode-pulse 1s ease-in-out infinite alternate; }.mode-pressed { transform: translateY(4rpx) scale(.96); background: #94a3b8 !important; box-shadow: 0 1rpx 3rpx rgba(15,23,42,.12) !important; }.pad-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }.move { font-size: 25rpx; padding: 0; background: #dbeafe; color: #1e3a8a; transition: transform .08s, background-color .08s, box-shadow .08s; box-shadow: 0 8rpx 15rpx rgba(37,99,235,.16); }.move.stop { background: #fef3c7; color: #92400e; box-shadow: 0 8rpx 15rpx rgba(245,158,11,.15); }.move-pressed { transform: translateY(5rpx) scale(.92); background: #93c5fd !important; box-shadow: 0 1rpx 3rpx rgba(37,99,235,.12) !important; }.stop-pressed { transform: translateY(5rpx) scale(.92); background: #fbbf24 !important; box-shadow: 0 1rpx 3rpx rgba(245,158,11,.12) !important; }.emergency { margin-top: 10rpx; height: 96rpx; line-height: 96rpx; font-size: 34rpx; transition: transform .08s, background-color .08s, box-shadow .08s; box-shadow: 0 10rpx 20rpx rgba(220,38,38,.25); }.danger-pressed { transform: translateY(6rpx) scale(.97); background: #991b1b !important; box-shadow: 0 2rpx 5rpx rgba(220,38,38,.18) !important; }@keyframes mode-pulse { from { opacity: .72; } to { opacity: 1; } }
.control-map-card .section-title { margin-bottom: 0; }
.map-link { color: #2563eb; font-size: 23rpx; }
.control-map-stage { position: relative; width: 100%; height: 460rpx; margin-top: 16rpx; overflow: hidden; border-radius: 16rpx; background: #e2e8f0; }
.control-map-image { position: absolute; inset: 0; width: 100%; height: 100%; }
.control-map-overlay { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
.control-map-empty { position: absolute; inset: 0; display: flex; justify-content: center; align-items: center; color: #64748b; font-size: 25rpx; }
.mode-row { display: grid; grid-template-columns: 1fr 1fr; }.mode-btn { width: 100%; }
