.indoor-page { padding-bottom: 40rpx; }.header-card { background: linear-gradient(135deg, #172554, #2563eb); color: #fff; }.header-card .muted { color: #bfdbfe; margin-top: 12rpx; }.map-card { padding: 16rpx; }.map-stage { position: relative; width: 100%; height: 680rpx; overflow: hidden; border-radius: 16rpx; background: #e2e8f0; }.map-content { position: relative; width: 100%; height: 100%; }.map-image { position: absolute; inset: 0; width: 100%; height: 100%; }.overlay { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }.map-empty { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 14rpx; color: #475569; font-size: 26rpx; }.zoom-controls { display: flex; justify-content: center; gap: 16rpx; margin-top: 14rpx; }.zoom-btn { width: 112rpx; height: 64rpx; line-height: 64rpx; padding: 0; margin: 0; color: #1e3a8a; background: #dbeafe; font-size: 34rpx; font-weight: 700; }.zoom-btn.reset { width: 150rpx; color: #334155; background: #e2e8f0; font-size: 24rpx; }.zoom-tip { margin-top: 10rpx; text-align: center; color: #64748b; font-size: 21rpx; }.map-meta { padding: 12rpx 4rpx 0; color: #64748b; font-size: 22rpx; }.toolbar { display: flex; gap: 12rpx; padding: 18rpx; }.tool-btn { flex: 1; height: 72rpx; line-height: 72rpx; margin: 0; padding: 0 8rpx; border-radius: 14rpx; color: #fff; background: #1e3a8a; box-shadow: 0 7rpx 0 #0f245f, 0 9rpx 18rpx rgba(30, 58, 138, .24); font-size: 23rpx; font-weight: 600; transition: transform 80ms ease, background-color 80ms ease, box-shadow 80ms ease, opacity 80ms ease; }.tool-btn::after { border: none; }.tool-btn.primary { color: #fff; background: #1e3a8a; }.tool-btn.tool-pressed { background: #0f245f; box-shadow: 0 2rpx 0 #09183f, inset 0 4rpx 10rpx rgba(0, 0, 0, .28); transform: translateY(6rpx) scale(.96); opacity: .9; }.tool-pressed { transform: translateY(3rpx) scale(.96); opacity: .8; }.section-title { font-weight: 700; margin-bottom: 14rpx; }.waypoint-row { display: flex; align-items: center; gap: 10rpx; padding: 14rpx 0; border-bottom: 1rpx solid #e2e8f0; }.waypoint-number { width: 42rpx; height: 42rpx; line-height: 42rpx; border-radius: 50%; text-align: center; background: #f59e0b; color: #fff; }.waypoint-info { flex: 1; display: flex; flex-direction: column; gap: 4rpx; font-size: 25rpx; }.mini-btn { min-width: 44rpx; height: 44rpx; line-height: 44rpx; padding: 0; margin: 0; font-size: 24rpx; background: #e2e8f0; }.mini-btn.delete { color: #b91c1c; }.patrol-row { display: flex; gap: 12rpx; }.patrol-btn { flex: 1; margin: 0; padding: 0; font-size: 25rpx; background: #e2e8f0; }.patrol-btn.selected { background: #1e3a8a; color: #fff; }.dwell-row { margin: 18rpx 0; font-size: 24rpx; }.start-btn { margin-top: 12rpx; }.cancel-btn { margin-top: 16rpx; background: #e2e8f0; color: #334155; }.emergency { margin-top: 18rpx; height: 92rpx; line-height: 92rpx; font-size: 34rpx; }
.mode-card { padding-bottom: 18rpx; }.mode-entry-row { display: flex; gap: 12rpx; }.mode-entry { flex: 1; height: 76rpx; line-height: 76rpx; margin: 0; padding: 0 6rpx; border-radius: 14rpx; color: #334155; background: #e2e8f0; font-size: 23rpx; }.mode-entry::after { border: 0; }.mode-entry.active { color: #fff; background: #1e3a8a; box-shadow: 0 7rpx 15rpx rgba(30,58,138,.28); }.mode-entry.switching { color: #fff; background: #2563eb; }.mode-entry-pressed { color: #fff !important; background: #0f245f !important; transform: translateY(5rpx) scale(.95); }
.mode-entry-row { display: grid; grid-template-columns: 1fr 1fr; }.mode-entry { width: 100%; }
