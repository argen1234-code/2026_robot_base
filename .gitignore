# 编辑器 / 系统
.vscode/
.idea/
*.swp
*~
.DS_Store

# Jetson ROS workspace is robot_ros2_ws/; ignore legacy local workspace
# artifacts that may exist at the repository root.
/build/
/install/
/log/
/src/

# Test/build caches
.pytest_cache/
__pycache__/
# tools/pid_host_test 是用 gcc 编译真实 pid.c 做主循环验证的临时工具，
# 只提交源码，不提交可执行文件
tools/pid_host_test/test_pid

# tf2_tools view_frames 的输出是一次性调试图，不入库
frames.gv
frames.pdf
frames_*.gv
frames_*.pdf

# ===== monorepo: AI 工作区 / 第三方依赖 =====
/ai_ws/build/
/ai_ws/install/
/ai_ws/log/
/third_party/orbbec_ws/build/
/third_party/orbbec_ws/install/
/third_party/orbbec_ws/log/

# 模型权重体积大，仅本地保存，用 scripts/fetch-models.sh 下载
**/MODELS/

# 密钥与本地配置（只提交 .env.example）
.env
.env.*
!.env.example
*.local
project.private.config.json

# 运行产物
# 运行时日志目录（OrbbecSDK.log.txt 等，体积大且每台机器不同）
/Log/
/ai_ws/src/largemodel/resources_file/tts_output.*
/ai_ws/src/largemodel/resources_file/XUNFEI_TTS.mp3
/ai_ws/src/largemodel/resources_file/user_speech.wav
/ai_ws/src/largemodel/resources_file/captured_frame_*.jpg
/ai_ws/src/largemodel/resources_file/analyze_video/
/ai_ws/src/largemodel/resources_file/generated_images/

# 备份 / 编辑器残留
*.bak
*.bak[0-9]*
*.save
*.swo
*.swn
*.swm
*.log

# 重复的原始导出（mesh 与 src 相同，仅保留原始 URDF）
/robot_ros2_ws/麦克纳姆轮小车urdf模型文件/

# YDLidar SDK 源码（第三方，用 scripts/build-nav.sh 自动克隆）
/third_party/ydlidar_sdk/

# 运行时会话及电脑帧率监视环境
/ai_ws/src/largemodel/resources_file/conversation_message.json
/tools/frame_rate_monitor/.venv/
